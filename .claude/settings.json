{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(basename *)",
      "Bash(for *)",
      "Read(workflows/ai-content-pipeline/**)",
      "Write(workflows/ai-content-pipeline/**)"
    ]
  }
}
